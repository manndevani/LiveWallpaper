// livewall.rc - file details shown in Explorer (Properties > Details).
// Code signing also requires the product name and version to be set here.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    LW_VERSION_MAJOR, LW_VERSION_MINOR, LW_VERSION_PATCH, 0
 PRODUCTVERSION LW_VERSION_MAJOR, LW_VERSION_MINOR, LW_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "livewall"
            VALUE "FileDescription",  "livewall - tiny live wallpaper"
            VALUE "FileVersion",      LW_VERSION_STR
            VALUE "InternalName",     "livewall"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Mann Devani. MIT License."
            VALUE "OriginalFilename", "livewall.exe"
            VALUE "ProductName",      "livewall"
            VALUE "ProductVersion",   LW_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
